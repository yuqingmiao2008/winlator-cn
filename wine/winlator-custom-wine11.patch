+
+static const char *winlator_rootfs_dir( void )
+{
+    static char root[256];
+    if (!root[0])
+    {
+        const char *tmp = getenv( "TMPDIR" );
+        if (tmp && *tmp)
+        {
+            size_t len = strlen( tmp );
+            if (len > 4 && !strcmp( tmp + len - 4, "/tmp" )) len -= 4;
+            if (len >= sizeof(root)) len = sizeof(root) - 1;
+            memcpy( root, tmp, len );
+            root[len] = 0;
+        }
+        else strcpy( root, "/" );
+    }
+    return root;
+}
